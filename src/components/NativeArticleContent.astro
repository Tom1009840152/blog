---
import type { ArticleMeta, DomainMeta, SectionMeta } from '../data/content';
import type { NativeArticleContent } from '../data/article-content';

interface Props {
  article: ArticleMeta;
  section?: SectionMeta;
  domain: DomainMeta;
  content: NativeArticleContent;
}

const { article, section, domain, content } = Astro.props;
const primaryToc = content.toc.filter(item => item.level === 2);
---

<article class="article-page native-article-page" data-article-page>
  <header class="article-page-header">
    <p>{domain.title} <span>/</span> {section?.title || '篇章引言'}</p>
    <h1>{article.title}</h1>
    {content.meta.length > 0 && (
      <div class="article-source-meta" aria-label="文章信息">
        {content.meta.map(item => <span>{item}</span>)}
      </div>
    )}
    <div class="article-tags">
      {article.tags.map(tag => <span>{tag}</span>)}
    </div>
  </header>

  <style is:inline set:html={content.css}></style>

  {primaryToc.length > 0 && (
    <button
      class="article-toc-toggle"
      type="button"
      data-article-toc-toggle
      aria-controls="article-table-of-contents"
      aria-expanded="false"
    >
      <span>本篇目录</span>
      <strong>{String(primaryToc.length).padStart(2, '0')} SECTIONS</strong>
      <i aria-hidden="true">↗</i>
    </button>
  )}

  <div class="article-reading-layout">
    <div class="native-article-content">
      <article class="article-body" set:html={content.html}></article>
    </div>

    {primaryToc.length > 0 && (
      <aside class="article-toc" id="article-table-of-contents" data-article-toc aria-label="本篇目录">
        <div class="article-toc-head">
          <div>
            <span>ON THIS PAGE</span>
            <h2>本篇目录</h2>
          </div>
          <button class="article-toc-close" type="button" data-article-toc-close aria-label="关闭本篇目录">×</button>
        </div>
        <div class="article-toc-progress" aria-hidden="true">
          <span data-article-progress></span>
        </div>
        <div class="article-toc-status">
          <span>READING PROGRESS</span>
          <strong data-article-progress-value>0%</strong>
        </div>
        <nav class="article-toc-links">
          {primaryToc.map(item => (
            <a
              href={`#${item.id}`}
              class="article-toc-link"
              data-article-toc-link
            >
              <span aria-hidden="true"></span>
              <strong>{item.label}</strong>
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>

  {primaryToc.length > 0 && (
    <button class="article-toc-overlay" type="button" data-article-toc-overlay aria-label="关闭本篇目录"></button>
  )}
  {content.script && <script is:inline set:html={content.script}></script>}
</article>

<script>
  const articlePage = document.querySelector<HTMLElement>('[data-article-page]');
  const toc = articlePage?.querySelector<HTMLElement>('[data-article-toc]');
  const toggle = articlePage?.querySelector<HTMLButtonElement>('[data-article-toc-toggle]');
  const close = articlePage?.querySelector<HTMLButtonElement>('[data-article-toc-close]');
  const overlay = articlePage?.querySelector<HTMLButtonElement>('[data-article-toc-overlay]');
  const links = Array.from(articlePage?.querySelectorAll<HTMLAnchorElement>('[data-article-toc-link]') || []);
  const progress = articlePage?.querySelector<HTMLElement>('[data-article-progress]');
  const progressValue = articlePage?.querySelector<HTMLElement>('[data-article-progress-value]');
  const contentRoot = articlePage?.querySelector<HTMLElement>('.native-article-content');
  const headings = links
    .map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  function setTocOpen(open: boolean) {
    articlePage?.toggleAttribute('data-toc-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('article-toc-open', open);
  }

  function setActiveHeading(id: string) {
    links.forEach(link => {
      const active = decodeURIComponent(link.hash.slice(1)) === id;
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  let scheduled = false;
  function syncReadingState() {
    if (!articlePage || !contentRoot || headings.length === 0) return;

    const marker = Math.min(190, window.innerHeight * 0.28);
    let current = headings[0];
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= marker) current = heading;
      else break;
    }
    setActiveHeading(current.id);

    const contentTop = contentRoot.getBoundingClientRect().top + window.scrollY;
    const start = contentTop - marker;
    const distance = Math.max(contentRoot.offsetHeight - window.innerHeight * 0.55, 1);
    const percentage = Math.round(Math.min(1, Math.max(0, (window.scrollY - start) / distance)) * 100);
    if (progress) progress.style.width = `${percentage}%`;
    if (progressValue) progressValue.textContent = `${percentage}%`;
    scheduled = false;
  }

  function scheduleReadingState() {
    if (scheduled) return;
    scheduled = true;
    window.requestAnimationFrame(syncReadingState);
  }

  toggle?.addEventListener('click', () => setTocOpen(!articlePage?.hasAttribute('data-toc-open')));
  close?.addEventListener('click', () => setTocOpen(false));
  overlay?.addEventListener('click', () => setTocOpen(false));
  links.forEach(link => link.addEventListener('click', () => setTocOpen(false)));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') setTocOpen(false);
  });
  window.addEventListener('scroll', scheduleReadingState, { passive: true });
  window.addEventListener('resize', scheduleReadingState);
  toc?.addEventListener('focusin', scheduleReadingState);
  syncReadingState();
</script>
