---
import type { DomainMeta } from '../data/content';
import { sitePath } from '../utils/paths';

interface Props {
  domain: DomainMeta;
}

const { domain } = Astro.props;
const articleCount = domain.sections.reduce((sum, section) => sum + section.articles.length, 0);
---

<article class="domain-overview">
  <header class="domain-hero">
    <p class="domain-eyebrow">Domain {domain.index} · {domain.englishTitle}</p>
    <h2>{domain.title}</h2>
    <p>{domain.description}</p>
    <div class="domain-stats" aria-label="领域统计">
      <span><strong>{String(domain.sections.length).padStart(2, '0')}</strong>二级分类</span>
      <span><strong>{String(articleCount).padStart(2, '0')}</strong>篇文章</span>
    </div>
  </header>

  <div class="section-overview-list">
    {domain.sections.map((section, sectionIndex) => (
      <section class="section-overview" id={section.id}>
        <div class="section-overview-heading">
          <span>{String(sectionIndex + 1).padStart(2, '0')}</span>
          <div>
            <h3>{section.title}</h3>
            <p>{section.description}</p>
          </div>
        </div>
        <div class="overview-article-list">
          {section.articles.map((article, articleIndex) => (
            <a href={sitePath(`/article/${article.id}/`)}>
              <span class="overview-article-number">{String(articleIndex + 1).padStart(2, '0')}</span>
              <span>
                <strong>{article.title}</strong>
                <small>{article.tags.join(' · ')}</small>
              </span>
              <span class="overview-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</article>
