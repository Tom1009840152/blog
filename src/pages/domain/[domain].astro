---
import NativeArticleContent from '../../components/NativeArticleContent.astro';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { contentDomains, getDomainArticles, type DomainMeta } from '../../data/content';
import { loadNativeArticle } from '../../data/article-content';

export function getStaticPaths() {
  return contentDomains.map(domain => ({ params: { domain: domain.id }, props: { domain } }));
}

interface Props {
  domain: DomainMeta;
}

const { domain } = Astro.props;
const article = domain.introduction;
const content = await loadNativeArticle(article.sourceFile);
const nextArticle = getDomainArticles(domain.id)[0];
---

<ReaderLayout
  domain={domain}
  currentArticle={article}
  nextArticle={nextArticle}
  pageTitle={article.title}
  description={domain.description}
>
  <NativeArticleContent article={article} domain={domain} content={content} />
</ReaderLayout>
