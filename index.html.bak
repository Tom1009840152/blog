<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>聚合叉的博客</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #F7F5F0;
    --bg-card: #FFFFFF;
    --text-primary: #1A1814;
    --text-secondary: #5C5850;
    --text-tertiary: #9A948A;
    --accent: #C4622A;
    --accent-light: #FAE8DC;
    --accent-mid: #E8855A;
    --border: rgba(60,50,40,0.1);
    --border-strong: rgba(60,50,40,0.2);
    --serif: 'Noto Serif SC', Georgia, serif;
    --sans: 'Noto Sans SC', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text-primary);
    font-family: var(--sans);
    font-weight: 400;
    line-height: 1.85;
    min-height: 100vh;
  }

  /* ── Header ── */
  .site-header {
    border-bottom: 0.5px solid var(--border);
    padding: 18px 0;
    position: sticky;
    top: 0;
    background: rgba(247,245,240,0.92);
    backdrop-filter: blur(12px);
    z-index: 100;
  }

  .header-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .header-nav {
    display: flex;
    gap: 28px;
    list-style: none;
  }

  .header-nav a {
    font-size: 13px;
    color: var(--text-tertiary);
    text-decoration: none;
    font-weight: 400;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .header-nav a:hover { color: var(--accent); }

  /* ── Hero Banner ── */
  .home-hero {
    max-width: 900px;
    margin: 0 auto;
    padding: 72px 32px 56px;
    border-bottom: 0.5px solid var(--border);
    animation: fadeUp 0.6s ease both;
  }

  .home-hero-label {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .home-hero-label::after {
    content: '';
    display: block;
    height: 1px;
    width: 40px;
    background: var(--accent-mid);
    opacity: 0.5;
  }

  .home-hero h1 {
    font-family: var(--serif);
    font-size: 38px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .home-hero p {
    font-size: 15px;
    color: var(--text-secondary);
    font-weight: 400;
    max-width: 480px;
  }

  /* ── Tag Filter ── */
  .filter-bar {
    max-width: 900px;
    margin: 0 auto;
    padding: 28px 32px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
    margin-right: 4px;
  }

  .filter-tag {
    font-size: 12px;
    padding: 5px 14px;
    border-radius: 20px;
    border: 0.5px solid var(--border-strong);
    color: var(--text-secondary);
    font-weight: 400;
    cursor: pointer;
    transition: all 0.2s;
    background: transparent;
    font-family: var(--sans);
    letter-spacing: 0.02em;
  }

  .filter-tag:hover, .filter-tag.active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-light);
  }

  /* ── Article Grid ── */
  .articles-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 32px 80px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
  }

  /* ── Card ── */
  .card {
    background: var(--bg-card);
    border: 0.5px solid var(--border);
    border-radius: 14px;
    padding: 28px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    cursor: pointer;
    animation: fadeUp 0.5s ease both;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(60,40,20,0.1);
    border-color: var(--accent-mid);
  }

  .card-kicker {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-kicker-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .card-title {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    letter-spacing: -0.005em;
  }

  .card-desc {
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 400;
    line-height: 1.75;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 0.5px solid var(--border);
    margin-top: 4px;
  }

  .card-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .card-tag {
    font-size: 10px;
    padding: 3px 9px;
    border-radius: 20px;
    border: 0.5px solid var(--border-strong);
    color: var(--text-tertiary);
    font-weight: 400;
    letter-spacing: 0.03em;
  }

  .card-date {
    font-size: 11px;
    color: var(--text-tertiary);
    font-weight: 400;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 8px;
  }

  .card-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 0.5px solid var(--border-strong);
    color: var(--text-tertiary);
    font-size: 13px;
    transition: all 0.2s;
    flex-shrink: 0;
    margin-left: 8px;
  }

  .card:hover .card-arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* ── Empty state ── */
  .empty-state {
    text-align: center;
    padding: 60px 0;
    color: var(--text-tertiary);
    font-size: 14px;
    display: none;
  }

  /* ── Footer ── */
  .site-footer {
    border-top: 0.5px solid var(--border);
    padding: 28px 32px;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--text-tertiary);
  }

  /* ── Animation ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .home-hero h1 { font-size: 28px; }
    .home-hero { padding: 48px 20px 36px; }
    .articles-section { padding: 24px 20px 60px; }
    .articles-grid { grid-template-columns: 1fr; }
    .filter-bar { padding: 20px 20px 0; }
    .header-inner { padding: 0 20px; }
    .header-nav { gap: 16px; }
  }
</style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <a class="site-name" href="index.html">聚合叉的博客</a>
    <nav>
      <ul class="header-nav">
        <li><a href="index.html">文章</a></li>
        <li><a href="about.html">关于</a></li>
      </ul>
    </nav>
  </div>
</header>

<section class="home-hero">
  <div class="home-hero-label">Personal Blog</div>
  <h1>聚合叉的博客</h1>
  <p>记录技术思考与探索，专注 AI、图像生成与工程实践。</p>
</section>

<!-- 标签筛选栏，由 JS 自动生成 -->
<div class="filter-bar" id="filterBar">
  <span class="filter-label">筛选</span>
</div>

<!-- 文章卡片区域 -->
<main class="articles-section">
  <div class="articles-grid" id="articlesGrid"></div>
  <div class="empty-state" id="emptyState">该标签下暂无文章</div>
</main>

<footer class="site-footer">
  <span>聚合叉的博客</span>
  <span id="articleCount"></span>
</footer>

<script>
// ═══════════════════════════════════════════════
//  📝 文章列表 — 新增文章只需在这里加一条记录
// ═══════════════════════════════════════════════
const articles = [
  {
    title: "为什么 GPT Image 2 的画面总感觉「不够丝滑」？",
    desc: "从 VQ-VAE 量化误差、码本瓶颈到自回归预测误差积累，拆解自回归图像模型与扩散模型在视觉质感上的根本差异。",
    date: "2026-05-27",
    tags: ["AI", "图像生成", "自回归模型"],
    category: "技术科普",
    url: "posts/gpt-image2.html"
  },
  {
    title: "扩散模型是怎么「画画」的？从噪声到图像的完整原理",
    desc: "从加噪/去噪的核心直觉，到 U-Net、CFG 文字引导、DDIM 加速采样、Latent Diffusion 潜空间压缩，完整拆解扩散模型的工作原理。",
    date: "2026-05-27",
    tags: ["AI", "图像生成", "扩散模型"],
    category: "技术科普",
    url: "posts/diffusion-model.html"
  },
  // ← 在这里继续添加新文章，格式同上
];

// ═══════════════════════════════════════════════
//  以下无需修改
// ═══════════════════════════════════════════════

let activeTag = null;

// 收集所有标签
function getAllTags() {
  const tagSet = new Set();
  articles.forEach(a => a.tags.forEach(t => tagSet.add(t)));
  return [...tagSet];
}

// 渲染标签筛选栏
function renderFilterBar() {
  const bar = document.getElementById('filterBar');
  const allBtn = document.createElement('button');
  allBtn.className = 'filter-tag active';
  allBtn.textContent = '全部';
  allBtn.onclick = () => setFilter(null, allBtn);
  bar.appendChild(allBtn);

  getAllTags().forEach(tag => {
    const btn = document.createElement('button');
    btn.className = 'filter-tag';
    btn.textContent = tag;
    btn.onclick = () => setFilter(tag, btn);
    bar.appendChild(btn);
  });
}

function setFilter(tag, btn) {
  activeTag = tag;
  document.querySelectorAll('.filter-tag').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderCards();
}

// 渲染文章卡片
function renderCards() {
  const grid = document.getElementById('articlesGrid');
  const empty = document.getElementById('emptyState');
  grid.innerHTML = '';

  const filtered = activeTag
    ? articles.filter(a => a.tags.includes(activeTag))
    : articles;

  if (filtered.length === 0) {
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';

  filtered.forEach((article, i) => {
    const a = document.createElement('a');
    a.className = 'card';
    a.href = article.url;
    a.style.animationDelay = `${i * 0.07}s`;

    a.innerHTML = `
      <div class="card-kicker">
        <span class="card-kicker-dot"></span>
        ${article.category}
      </div>
      <div class="card-title">${article.title}</div>
      <div class="card-desc">${article.desc}</div>
      <div class="card-footer">
        <div class="card-tags">
          ${article.tags.map(t => `<span class="card-tag">${t}</span>`).join('')}
        </div>
        <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">
          <span class="card-date">${article.date}</span>
          <span class="card-arrow">→</span>
        </div>
      </div>
    `;
    grid.appendChild(a);
  });
}

// 初始化
document.getElementById('articleCount').textContent = `共 ${articles.length} 篇文章`;
renderFilterBar();
renderCards();
</script>
</body>
</html>
